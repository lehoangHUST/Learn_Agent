# Copy thành .env. Không commit .env.

# --- Model ---
# Để trống OPENAI_API_KEY thì vẫn chạy được mọi kịch bản `--demo` (offline).
OPENAI_API_KEY=
HARNESS_MODEL_PROVIDER=openai
HARNESS_MODEL=gpt-4o-mini
HARNESS_TEMPERATURE=0.0

# --- Dữ liệu ---
HARNESS_DB=data/demo.db
HARNESS_FINDINGS=data/findings.json

# --- Checkpoint: BẮT BUỘC có nếu dùng tool cần phê duyệt ---
# sqlite | memory | none
HARNESS_CHECKPOINTER=sqlite
HARNESS_CHECKPOINT_DB=data/checkpoints.db

# --- Quyền ---
# Bỏ findings:write ra để thử nhánh "model xin tool mà nó không có quyền".
HARNESS_PERMISSIONS=sql:read,findings:write

# --- Hạn mức: đây là phần an toàn của harness, không phải phần hiệu năng ---
HARNESS_MAX_MODEL_CALLS=8
HARNESS_MAX_TOOL_CALLS=24
HARNESS_MAX_IDENTICAL=2
HARNESS_MAX_ACTIVE_SECONDS=120
HARNESS_MAX_RESULT_CHARS=4000
HARNESS_MAX_TOTAL_RESULT_CHARS=40000
HARNESS_MAX_PARALLEL_TOOLS=4

# --- Giới hạn SQL ---
HARNESS_SQL_MAX_ROWS=200
HARNESS_SQL_TIMEOUT=5
HARNESS_SQL_MAX_CELL_CHARS=200

HARNESS_LOG_LEVEL=INFO
