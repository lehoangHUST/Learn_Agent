# Copy thành .env rồi điền. KHÔNG commit .env.
# Mọi biến ở đây override giá trị trong configs/config.yaml.

# ---------------------------------------------------------------------------
# Backend face (imintv3) - detection + embedding trong một lời gọi
# ---------------------------------------------------------------------------
FACE_AI_VISION_BACKEND=imint_v3
FACE_AI_VISION_BASE_URL=http://10.9.3.239:3124
FACE_AI_VISION_TIMEOUT=30
FACE_AI_VISION_MAX_RETRIES=2

# aligned | unaligned. Đổi -> phải build lại index.
FACE_AI_EMBEDDING_SPACE=aligned
FACE_AI_MIN_FACE_SIZE_PX=32

# ---------------------------------------------------------------------------
# Matching - CHƯA HIỆU CHUẨN, xem configs/config.yaml
# ---------------------------------------------------------------------------
FACE_AI_MATCH_THRESHOLD=0.55
FACE_AI_REVIEW_BAND=0.05
FACE_AI_AMBIGUOUS_MARGIN=0.03
FACE_AI_TOP_K=5
FACE_AI_MATCHING_CALIBRATED=false

# ---------------------------------------------------------------------------
# Storage / persistence
# ---------------------------------------------------------------------------
FACE_AI_INDEX_DIR=data/index
FACE_AI_COLLECTION=default
FACE_AI_IMAGE_DIR=data/images
FACE_AI_PERSIST_QUERY_IMAGES=false
FACE_AI_IMAGE_TTL=3600
FACE_AI_RESULTS_DB=data/results/results.db
FACE_AI_RESULT_TTL=86400
FACE_AI_CHECKPOINTER=sqlite
FACE_AI_CHECKPOINT_DB=data/results/checkpoints.db

# ---------------------------------------------------------------------------
# LLM (tuỳ chọn). enabled=false -> hệ thống vẫn chạy đủ chức năng, trả lời bằng
# template xác định thay vì văn tự nhiên.
# ---------------------------------------------------------------------------
FACE_AI_LLM_ENABLED=false
FACE_AI_LLM_PROVIDER=openai
FACE_AI_LLM_MODEL=gpt-4o-mini
FACE_AI_LLM_TEMPERATURE=0.0
OPENAI_API_KEY=

# ---------------------------------------------------------------------------
# Xác thực (DEMO)
# ---------------------------------------------------------------------------
# Cú pháp: <token>|<user_id>|<role,role,...>|<collection,collection,...>
# Nhiều principal phân tách bằng ';'. Quyền: admin, face:search, face:register,
# face:delete, face:read_metadata.
# Dấu phân tách là '|' và ',' chứ KHÔNG phải ':' - vì tên quyền đã chứa ':'.
#
# Để trống + FACE_AI_ENVIRONMENT=dev  -> cho phép truy cập ẩn danh (chỉ để phát triển).
# Để trống + environment != dev       -> mọi request bị 401.
FACE_AI_TOKENS=dev-token|dev-user|face:search,face:register,face:read_metadata|default

# ---------------------------------------------------------------------------
# Limits & observability
# ---------------------------------------------------------------------------
FACE_AI_MAX_IMAGE_BYTES=8388608
FACE_AI_MAX_IMAGES_PER_REQUEST=8
FACE_AI_RATE_LIMIT_PER_MINUTE=60
FACE_AI_LOG_LEVEL=INFO
FACE_AI_JSON_LOGS=true

# Langfuse (tuỳ chọn) - mỗi node LangGraph thành một span
FACE_AI_LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
